          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resetting asks twice — deleted files cannot be recovered on the device."
          }
        }
      }
    },
    "iPhone ans Kabel, im Finder das Gerät auswählen, Reiter „Dateien“, dort „Vicious SID“ aufklappen. In dieses Feld lassen sich ganze Ordner per Drag & Drop ziehen. Für große Sammlungen ist das der schnellste Weg. Dieselbe Ablage erscheint auf dem iPhone in der Dateien-App unter „Auf meinem iPhone“.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ans Kabel, im Finder das Gerät auswählen, Reiter „Dateien“, dort „Vicious SID“ aufklappen. In dieses Feld lassen sich ganze Ordner per Drag & Drop ziehen. Für große Sammlungen ist das der schnellste Weg. Dieselbe Ablage erscheint auf dem iPhone in der Dateien-App unter „Auf meinem iPhone“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug the iPhone in, select the device in the Finder, open the “Files” tab and expand “Vicious SID”. Whole folders can be dragged into that area. For large collections this is the fastest route. The same storage appears on the iPhone in the Files app under “On My iPhone”."
          }
        }
      }
    },
