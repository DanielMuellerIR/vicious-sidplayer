    "Auto folgt der Angabe in der Datei. Viele Stücke klingen nur auf dem Chip richtig, für den sie geschrieben wurden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto folgt der Angabe in der Datei. Viele Stücke klingen nur auf dem Chip richtig, für den sie geschrieben wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto follows the setting stored in the file. Many tunes only sound right on the chip they were written for."
          }
        }
      }
    },
    "Auto-Next": {
      "localizations": {
