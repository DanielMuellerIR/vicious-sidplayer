    "Beim nächsten Start dort weitermachen, wo du aufgehört hast — Titel, Subtune und Position. Bei eingeschalteter Zufallswiedergabe wird bewusst nicht wiederhergestellt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim nächsten Start dort weitermachen, wo du aufgehört hast — Titel, Subtune und Position. Bei eingeschalteter Zufallswiedergabe wird bewusst nicht wiederhergestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick up next time where you left off — tune, subtune and position. With shuffle switched on this is deliberately skipped."
          }
        }
      }
    },
    "Bibliothek": {
      "localizations": {
