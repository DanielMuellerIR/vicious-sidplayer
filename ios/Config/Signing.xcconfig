// Signatur-Konfiguration der iOS-App.
//
// WELCHER WERT GEWINNT — von oben nach unten, oben schlaegt unten:
//   1. Die Kommandozeile: `xcodebuild DEVELOPMENT_TEAM=…`. Auf diesem Weg baut
//      `ios/scripts/build-device.sh` mit den Werten aus `ios/.env`.
//   2. Die `buildSettings` des App-Targets in der pbxproj. Dort stehen
//      DEVELOPMENT_TEAM und PRODUCT_BUNDLE_IDENTIFIER eingecheckt — bewusst, damit
//      „Projekt oeffnen und auf Start druecken" ohne jede Vorbereitung ein echtes
//      Geraet bespielt.
//   3. Diese Datei und das von ihr eingebundene `Local.xcconfig`. Sie haengen an
//      der Projekt-Ebene und kommen deshalb gegen Punkt 2 nicht an.
//
// Was der `ios/.env`-Weg damit wirklich leistet: `ios/scripts/apply-env.sh`
// erzeugt daraus `ios/Config/Local.xcconfig` (beide gitignoriert, Vorlage ist
// `ios/env.example`), und `build-device.sh` reicht dieselben Werte zusaetzlich an
// `xcodebuild` weiter. Fuer den Skript-Build (Punkt 1) wirkt das, fuer die
// Xcode-GUI nicht: dort gewinnt weiter die pbxproj. Wer in der GUI mit einem
// anderen Apple-Team oder einer anderen Bundle-ID bauen will — etwa in einem
// fremden Clone —, muss die beiden Werte zuerst in der pbxproj aendern oder
// entfernen. Nur Local.xcconfig zu fuellen reicht dafuer nicht.
//
// Ein Geheimnis ist die Team-ID dabei nicht — sie steht in diesem Repo ohnehin
// im Klartext in README.md, README.de.md, build_app.sh und build_dmg.sh, und
// seit die Xcode-GUI sie zusaetzlich in die pbxproj geschrieben hat, auch dort.
// Frueher stand an dieser Stelle, sie werde „bewusst NICHT eingecheckt"; das
// war nie durchgehalten und ist jetzt richtiggestellt, damit niemand die Regel
// glaubt und danach handelt.
//
// Das Fragezeichen in `#include?` heisst: fehlt die Datei, ist das kein Fehler.
// Genau so soll es sein — ohne Team-ID baut der Simulator weiterhin (dort wird
// gar nicht signiert), nur der Geraete-Build braucht sie.
#include? "Local.xcconfig"

// Simulator-Builds brauchen keine Signatur. Auf echter Hardware zieht der
// Wert aus der pbxproj bzw. Local.xcconfig oder der Kommandozeile.
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] =
CODE_SIGNING_REQUIRED[sdk=iphonesimulator*] = NO
CODE_SIGNING_ALLOWED[sdk=iphonesimulator*] = NO

// Auf dem Geraet signiert Xcode automatisch mit dem Team aus der pbxproj —
// oder, falls dort keins gesetzt ist, aus Local.xcconfig.
CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Development
